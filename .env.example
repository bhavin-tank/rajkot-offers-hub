# MongoDB connection. Local: mongodb://127.0.0.1:27017 · Atlas: mongodb+srv://<user>:<password>@<cluster>/
MONGODB_URI=mongodb://127.0.0.1:27017
# Database name (default rajkot_offers)
MONGODB_DB=rajkot_offers

# Signs session tokens and hashes sign-in codes. Required in production: at least 32 random characters
# (e.g. `openssl rand -base64 48`). Changing it signs everyone out.
AUTH_SECRET=
# Token lifetimes in seconds (defaults: 15 minutes / 30 days)
# ACCESS_TOKEN_TTL=900
# REFRESH_TOKEN_TTL=2592000

# WhatsApp Cloud API (Meta) for sign-in codes. Without a token in development, codes are printed to the server log.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
# Approved authentication template with a copy-code button, and its language
WHATSAPP_OTP_TEMPLATE=otp_login
WHATSAPP_TEMPLATE_LANGUAGE=en
# WHATSAPP_API_VERSION=v23.0

# Cloudflare R2 for uploaded photos. Without these in development, photos are saved under .data/uploads.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Public base URL of the bucket (custom domain or r2.dev URL), e.g. https://media.rajkotoffers.in
MEDIA_PUBLIC_URL=

# Shared secret the scheduler sends to /api/v1/cron/* as "Authorization: Bearer <secret>"
CRON_SECRET=
